{
  "opencollection": "1.0.0",
  "info": {
    "name": "Stellar Cyber Open XDR Alerts Reports API",
    "version": "6.3"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Reports",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{platformHostname}/connect/api/v1/reports"
          },
          "docs": "Retrieve all available security reports."
        },
        {
          "info": {
            "name": "Create Report",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{platformHostname}/connect/api/v1/reports",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generate a new security report."
        },
        {
          "info": {
            "name": "Delete Report",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{platformHostname}/connect/api/v1/reports/:reportId",
            "params": [
              {
                "name": "reportId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the report"
              }
            ]
          },
          "docs": "Delete a security report."
        }
      ]
    }
  ],
  "bundled": true
}