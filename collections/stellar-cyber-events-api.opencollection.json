{
  "opencollection": "1.0.0",
  "info": {
    "name": "Stellar Cyber Open XDR Alerts Events API",
    "version": "6.3"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Ingest Events",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{platformHostname}/connect/api/v1/events",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add security event documents to the platform's security event index. Supports both single and bulk event ingestion."
        }
      ]
    }
  ],
  "bundled": true
}