{
  "item": [
    {
      "id": "97c60436-4488-4b0a-9e62-73bd028bb091",
      "name": "Authentication",
      "description": {
        "content": "API key and JWT token management",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "8e010a5b-bc49-4808-872f-ea732d2b4b20",
          "name": "Get Access Token",
          "request": {
            "name": "Get Access Token",
            "description": {
              "content": "Generate a JWT access token using an API key. The JWT expires ten minutes after generation. Use the returned token as a Bearer token in subsequent API calls.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "access_token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Your Stellar Cyber platform hostname",
                  "type": "any",
                  "value": "{{platformHostname}}",
                  "key": "platformHostname"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "9568b76f-4e7e-4880-8e6c-c45ae546b9a7",
              "name": "JWT access token generated successfully",
              "originalRequest": {
                "url": {
                  "path": [
                    "access_token"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
                    {
                      "description": "Your Stellar Cyber platform hostname",
                      "type": "any",
                      "value": "{{platformHostname}}",
                      "key": "platformHostname"
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"access_token\": \"string\",\n  \"token_type\": \"bearer\",\n  \"expires_in\": 7637\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            },
            {
              "id": "7ecdfb6d-8ded-41bc-b94b-25d4aa58dc20",
              "name": "Authentication required or token expired",
              "originalRequest": {
                "url": {
                  "path": [
                    "access_token"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
                    {
                      "description": "Your Stellar Cyber platform hostname",
                      "type": "any",
                      "value": "{{platformHostname}}",
                      "key": "platformHostname"
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {}
              },
              "status": "Unauthorized",
              "code": 401,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"error\": \"string\",\n  \"message\": \"string\",\n  \"code\": 4549\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        }
      ],
      "event": []
    }
  ],
  "event": [],
  "variable": [
    {
      "description": {
        "content": "Your Stellar Cyber platform hostname",
        "type": "text/plain"
      },
      "type": "any",
      "value": "your-platform.stellarcyber.ai",
      "key": "platformHostname"
    },
    {
      "type": "string",
      "value": "https://{{platformHostname}}/connect/api/v1",
      "key": "baseUrl"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bearerToken}}"
      }
    ]
  },
  "info": {
    "_postman_id": "9405111c-694d-406c-b0c7-d99a082dcd9e",
    "name": "Stellar Cyber Open XDR Alerts Authentication API",
