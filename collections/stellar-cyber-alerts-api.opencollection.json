{
  "opencollection": "1.0.0",
  "info": {
    "name": "Stellar Cyber Open XDR Alerts API",
    "version": "6.3"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Alerts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Alerts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{platformHostname}/connect/api/v1/alerts",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of alerts to return"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Pagination offset"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by alert status"
              }
            ]
          },
          "docs": "Retrieve security alerts from the platform."
        },
        {
          "info": {
            "name": "Update Alert",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{platformHostname}/connect/api/v1/alerts/:alertId",
            "params": [
              {
                "name": "alertId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the alert"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update alert tags, status, and comments."
        }
      ]
    }
  ],
  "bundled": true
}