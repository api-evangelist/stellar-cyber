{
  "opencollection": "1.0.0",
  "info": {
    "name": "Stellar Cyber Open XDR Alerts Queries API",
    "version": "6.3"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Queries",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Queries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{platformHostname}/connect/api/v1/queries"
          },
          "docs": "Retrieve all saved queries."
        },
        {
          "info": {
            "name": "Create Query",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{platformHostname}/connect/api/v1/queries",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new saved query."
        },
        {
          "info": {
            "name": "Update Query",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{platformHostname}/connect/api/v1/queries/:queryId",
            "params": [
              {
                "name": "queryId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the query"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an existing saved query."
        },
        {
          "info": {
            "name": "Delete Query",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{platformHostname}/connect/api/v1/queries/:queryId",
            "params": [
              {
                "name": "queryId",
                "value": "",
                "type": "path",
                "description": "Unique identifier for the query"
              }
            ]
          },
          "docs": "Delete a saved query."
        }
      ]
    }
  ],
  "bundled": true
}